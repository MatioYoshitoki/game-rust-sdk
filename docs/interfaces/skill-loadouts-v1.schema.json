{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://match-kernel.local/skill-loadouts-v1.schema.json",
  "title": "Trusted member skill ownership and equipped slots",
  "oneOf": [
    {
      "$ref": "#/$defs/skillLoadout"
    },
    {
      "$ref": "#/$defs/setSkillLoadout"
    },
    {
      "$ref": "#/$defs/skillLoadoutReceipt"
    },
    {
      "$ref": "#/$defs/skillControlCheckpoint"
    },
    {
      "$ref": "#/$defs/skillLoadoutChanged"
    },
    {
      "$ref": "#/$defs/ownLoadoutProjection"
    },
    {
      "$ref": "#/$defs/skillLibraryProjection"
    },
    {
      "$ref": "#/$defs/skillLoadoutCommand"
    }
  ],
  "$defs": {
    "skillLoadoutId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "skillLoadoutMatchKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "incarnation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/skillLoadoutId"
        },
        "incarnation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "skillLoadout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned_skill_ids",
        "equipped_skill_ids"
      ],
      "properties": {
        "owned_skill_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillLoadoutId"
          }
        },
        "equipped_skill_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillLoadoutId"
          }
        }
      }
    },
    "setSkillLoadout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "participant_id",
        "entity_generation",
        "operation_id",
        "expected_revision",
        "loadout"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/skillLoadoutMatchKey"
        },
        "participant_id": {
          "$ref": "#/$defs/skillLoadoutId"
        },
        "entity_generation": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/skillLoadoutId"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "loadout": {
          "$ref": "#/$defs/skillLoadout"
        }
      }
    },
    "skillLoadoutReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "revision",
        "equipped_skill_ids"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/skillLoadoutId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "equipped_skill_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillLoadoutId"
          }
        }
      }
    },
    "skillLoadoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loadout",
        "revision",
        "declared"
      ],
      "properties": {
        "loadout": {
          "$ref": "#/$defs/skillLoadout"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "declared": {
          "type": "boolean"
        }
      }
    },
    "skillLoadoutOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "receipt"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/setSkillLoadout"
        },
        "receipt": {
          "$ref": "#/$defs/skillLoadoutReceipt"
        }
      }
    },
    "skillControlCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members",
        "operations"
      ],
      "properties": {
        "members": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "$ref": "#/$defs/skillLoadoutState"
          }
        },
        "operations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/skillLoadoutOperation"
          }
        }
      }
    },
    "skillLoadoutChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "revision",
        "equipped_skill_ids"
      ],
      "properties": {
        "kind": {
          "const": "skill_loadout_changed"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "equipped_skill_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillLoadoutId"
          }
        }
      }
    },
    "ownLoadoutProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_loadout_revision",
        "player_skills"
      ],
      "properties": {
        "skill_loadout_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "player_skills": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_id",
              "ready_at_ms"
            ],
            "properties": {
              "skill_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "ready_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    "skillLibraryProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_library"
      ],
      "properties": {
        "skill_library": {
          "type": "array",
          "minItems": 1,
          "maxItems": 63,
          "items": {
            "type": "object",
            "required": [
              "id",
              "mechanism"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "mechanism": {
                "enum": [
                  "projectile",
                  "unit_projectile",
                  "ground_circle",
                  "ground_field",
                  "line_field",
                  "piercing_projectile",
                  "self_status",
                  "ally_heal",
                  "ally_shield"
                ]
              }
            },
            "$comment": "Mechanism parameters are validated by the SDK skill loader; this fragment validates the library container and identity."
          }
        }
      }
    },
    "skillLoadoutCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request"
      ],
      "properties": {
        "type": {
          "const": "set_skill_loadout"
        },
        "request": {
          "$ref": "#/$defs/setSkillLoadout"
        }
      }
    }
  }
}
