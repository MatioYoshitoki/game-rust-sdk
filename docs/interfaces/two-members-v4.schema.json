{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:match-kernel:two-members-v4:create",
  "title": "CreateV4 and shared protocol-4 identity/responsibility DTOs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "key",
    "request_id",
    "config_id",
    "config_hash",
    "seed",
    "participants"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "authenticated_principal",
        "connection"
      ],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/id"
        },
        "authenticated_principal": {
          "$ref": "#/$defs/id"
        },
        "connection": {
          "$ref": "#/$defs/connection"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "generation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "participant",
            "monster"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "participantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "owner_id"
      ],
      "properties": {
        "entity": {
          "$ref": "#/$defs/entityRef"
        },
        "owner_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "legacyCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sha256"
      ],
      "properties": {
        "state": {
          "type": "object",
          "description": "Original schema-1 IoState, strictly decoded and validated by protocol.rs/recovery.rs; carried unchanged."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "description": "Opaque legacy member responsibility. The original Rust schema is authoritative; hosts must preserve every field."
    },
    "memberCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "checkpoint"
      ],
      "properties": {
        "participant_id": {
          "$ref": "#/$defs/id"
        },
        "checkpoint": {
          "$ref": "#/$defs/legacyCheckpoint"
        }
      }
    },
    "ioStateV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "identity_sha256",
        "logical_ms",
        "output_sequence",
        "recovery_generation",
        "members"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "logical_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recovery_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/memberCheckpoint"
          }
        }
      }
    },
    "checkpointV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sha256"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/ioStateV4"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "recoveryV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "checkpoint"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpointV4"
        }
      }
    }
  },
  "properties": {
    "protocol_version": {
      "const": 4
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "incarnation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "incarnation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "config_id": {
      "$ref": "#/$defs/id"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "publication_mode": {
      "enum": [
        "batched",
        "interactive"
      ]
    },
    "recovery": {
      "$ref": "#/$defs/recoveryV4"
    }
  }
}
