     assert_eq!(observed.iter().filter(|(owner,e)|*owner==Some(0)&&matches!(e,EventV4::Private{event:Event::ActionRejected{reason:Error::InvalidTarget,action_id:id}} if id==&action_id)).count(),oracle[2]["value"]);
