  "scopeDecisions": {
    "selection": "trusted seat profile; optional return sample represents an already resolved base passive",
    "corridor": "live target centers projected onto the frozen flight interval; full terrain sweep and cross-corridor line of sight",
    "seal": "only primary HP damage permits a seal when the path ends or hits a wall; leave the seal on the clear side of terrain",
    "recall": "anchor delayed launch schedule, freeze the current owner position for each flight, and wait for all terminal paths",
    "ricochet": "success selects the nearest distinct eligible identity by distance then ID; the next segment starts from the actual terminal contact point",
    "marks": "scoped by source and target generation; consume third mark even when the target rank resists the stun",
    "return": "from authoritative outbound terminal position to the current owner sampled on release; ignores collisions and damage; shields once after arrival and keeps the higher same-source remainder within shared cap",
    "capacity": "32 profile slots; corridor admission conservatively budgets possible same-step contacts from member count and configured NPC slots"
  },
